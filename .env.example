UPSTREAM_URL=https://example.com/api/schedule-snapshot.php
VITE_API_URL=https://pkplanner.sidearker.com/api/schedule
EXPO_PUBLIC_API_URL=https://pkplanner.sidearker.com/api/schedule
# Android build: path to Firebase google-services.json (package com.sidearker.pkplanner).
GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json
# Worker secret: full Firebase service account JSON for FCM HTTP v1.
FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# Worker secret: random token required to send emergency broadcasts.
NOTIFICATION_ADMIN_TOKEN=replace-with-a-long-random-secret
