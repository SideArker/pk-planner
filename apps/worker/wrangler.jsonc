{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pk-planner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api", "/schedule*", "/version*", "/health*"]
  }
}
