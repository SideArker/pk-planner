{
  "name": "pk-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile exec expo start --lan --go",
    "dev:mobile:remote": "node scripts/expo-remote.mjs",
    "dev:worker": "pnpm --filter worker dev",
    "build:web": "pnpm --filter web build",
    "build:mobile": "pnpm --filter mobile build",
    "build:worker": "pnpm build:web && pnpm --filter worker run deploy",
    "deploy:worker": "pnpm --filter worker run deploy",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint apps packages --fix",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "toqr": "0.1.1"
  }
}
